{
  "name": "workbase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:prepare",
    "prebuild": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "prisma:generate": "prisma generate",
    "db:prepare": "prisma generate && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-chat-citations": "tsx --env-file=.env scripts/backfill-chat-citations.ts",
    "db:backfill-repository-knowledge": "tsx --env-file=.env scripts/backfill-repository-knowledge.ts",
    "db:embedding-index": "tsx --env-file=.env scripts/manage-embedding-index.ts",
    "eval:project-chat": "tsx --env-file=.env scripts/evaluate-project-chat.ts",
    "eval:project-chat:suite": "tsx scripts/evaluate-project-chat-suite.ts",
    "eval:project-chat:application": "tsx --env-file=.env scripts/evaluate-project-chat-application.ts",
    "eval:project-chat:semantic-robustness": "tsx scripts/evaluate-project-chat-semantic-robustness.ts",
    "eval:embeddings": "tsx --env-file=.env scripts/evaluate-embedding-index.ts",
    "eval:openrouter:profiles": "tsx --env-file=.env scripts/evaluate-openrouter-profiles.ts",
    "test:eval": "vitest run src/evals/__tests__",
    "bedrock:preflight": "tsx scripts/bedrock-preflight.ts",
    "openrouter:preflight": "tsx --env-file=.env scripts/openrouter-preflight.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1024.0",
    "@aws-sdk/credential-providers": "^3.1024.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.11",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "unist-util-visit": "^5.1.0",
    "workflow": "^4.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "@workflow/vitest": "^4.0.12",
    "dotenv": "^17.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
