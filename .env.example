DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/workbase?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/workbase?sslmode=require"
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"
GITHUB_OAUTH_REDIRECT_URI="http://localhost:3000/api/github/callback"
# Per-request GitHub REST deadline. Repository imports fail visibly instead of
# occupying an action or workflow indefinitely when GitHub stops responding.
WORKBASE_GITHUB_REQUEST_TIMEOUT_MS="30000"
# Production-only HTTPS endpoint registered on attached repositories.
WORKBASE_GITHUB_WEBHOOK_URL="https://your-workbase.example/api/github/webhook"
GITHUB_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
WORKBASE_ENCRYPTION_KEY="replace-with-a-long-random-secret"
WORKBASE_DEMO_USER_EMAIL="demo@workbase.app"
WORKBASE_DEMO_USER_NAME="Workbase Demo User"
WORKBASE_LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY="replace-with-an-openrouter-api-key"
WORKBASE_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
WORKBASE_OPENROUTER_MODEL_ID="openai/gpt-5.6-terra"
WORKBASE_OPENROUTER_FALLBACK_MODEL_ID="anthropic/claude-sonnet-5"
WORKBASE_OPENROUTER_REQUEST_TIMEOUT_MS="240000"
WORKBASE_OPENROUTER_MIN_REQUEST_INTERVAL_MS="0"
WORKBASE_OPENROUTER_APP_NAME="Workbase"
WORKBASE_OPENROUTER_APP_URL="https://your-workbase.example"
# Optional comma-separated preference order. OpenRouter still performs
# same-model provider failover and every request requires ZDR-compatible
# endpoints with support for all supplied parameters.
# WORKBASE_OPENROUTER_PROVIDER_ORDER=""
# Live-validated profile routing. Keep the explicit values so deployment
# configuration cannot silently collapse specialized work back onto the base
# model. See docs/openrouter-migration.md for the comparison and safety gates.
WORKBASE_OPENROUTER_MODEL_PRIMARY_ANSWER="openai/gpt-5.6-terra"
WORKBASE_OPENROUTER_MODEL_DEEP_SYNTHESIS="openai/gpt-5.6-terra"
WORKBASE_OPENROUTER_MODEL_VERIFICATION="openai/gpt-5.6-luna"
WORKBASE_OPENROUTER_MODEL_DRAFTING="openai/gpt-5.6-luna"
WORKBASE_OPENROUTER_MODEL_CODE_EXTRACTION="openai/gpt-5.4-mini"
WORKBASE_OPENROUTER_MODEL_ROUTING="openai/gpt-5.6-luna"
WORKBASE_OPENROUTER_MODEL_JSON_REPAIR="openai/gpt-5.4-nano"
# Production and representative cold-import validation must exercise the
# configured deep_synthesis profile. Deterministic synthesis is a cost/debug
# alternative and cannot establish main-model quality.
WORKBASE_REPOSITORY_SYNTHESIS_MODE="model"
# Real providers use the bounded source-investigation agent by default.
# "orchestrated" keeps the previous fixed-funnel implementation available for
# paired evaluation; it is never an automatic fallback.
WORKBASE_REPOSITORY_INVESTIGATION_MODE="agentic"
# Production planning uses the configured routing profile. Deterministic
# planning applies only to the explicit orchestrated comparison mode.
WORKBASE_SEMANTIC_PLANNER_MODE="model"
# Cross-family Sonnet fallback is runtime-restricted to primary_answer; all
# specialized profiles use same-model provider failover only.
# Only enable after selecting a model whose OpenRouter endpoint metadata
# advertises temperature support.
# WORKBASE_OPENROUTER_SEND_TEMPERATURE="false"
# Bedrock remains the controlled rollback provider during migration.
WORKBASE_AWS_PROFILE="default"
WORKBASE_BEDROCK_REGION="us-east-1"
WORKBASE_BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-6"
# Selects the default candidate registered by the lifecycle CLI. Existing
# databases still require a gated DB index activation; changing this value
# alone never changes the active vector space.
WORKBASE_EMBEDDING_PROVIDER="openrouter"
WORKBASE_BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
WORKBASE_OPENROUTER_EMBEDDING_MODEL_ID="openai/text-embedding-3-small"
WORKBASE_OPENROUTER_EMBEDDING_CHALLENGER_MODEL_ID="openai/text-embedding-3-large"
WORKBASE_OPENROUTER_EMBEDDING_TIMEOUT_MS="60000"
WORKBASE_OPENROUTER_EMBEDDING_MAX_ATTEMPTS="2"
WORKBASE_MAX_EMBEDDING_WRITE_TARGETS="3"
WORKBASE_EMBEDDING_CACHE_TTL_MS="300000"
WORKBASE_BEDROCK_REQUEST_TIMEOUT_MS="240000"
WORKBASE_BEDROCK_INPUT_USD_PER_MILLION="3"
WORKBASE_BEDROCK_OUTPUT_USD_PER_MILLION="15"
WORKBASE_BEDROCK_CACHE_READ_USD_PER_MILLION="0.3"
WORKBASE_BEDROCK_CACHE_WRITE_USD_PER_MILLION="3.75"
# deterministic | hybrid | model. Hybrid is the safe default: deterministic
# citation checks run first and the configured verification profile is used only when semantic judgment is
# still required. Model forces semantic verification for every grounded answer.
WORKBASE_ANSWER_GROUNDING_MODE="hybrid"
# deterministic | shadow | hybrid. Hybrid uses the configured routing profile inside hard
# authorization, freshness, worker-count, and token-budget guardrails.
WORKBASE_EXECUTION_ROUTER_MODE="hybrid"
CRON_SECRET="replace-with-a-long-random-secret"
