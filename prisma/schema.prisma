generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CareerStage {
  student
  intern
  new_grad
  early_career_engineer
}

enum FocusPreference {
  projects
  work_experience
  both
}

enum WorkItemType {
  project
  experience
}

enum SourceType {
  manual_note
  github_repo
  chat_context
}

enum EvidenceItemType {
  manual_note_excerpt
  github_readme
  github_commit
  github_pull_request
  github_issue
  github_release
  chat_user_statement
  github_file_excerpt
}

enum ClaimConfidence {
  low
  medium
  high
}

enum OwnershipClarity {
  unclear
  partial
  clear
}

enum VerificationStatus {
  draft
  approved
  flagged
  rejected
}

enum ProjectFactCategory {
  architecture
  behavior
  data_flow
  code_location
  dependency
  configuration
}

enum ProjectFactStatus {
  draft
  approved
  rejected
  superseded
}

enum VisibilityLevel {
  private
  resume_safe
  linkedin_safe
  public_safe
}

enum ArtifactType {
  resume_bullets
  linkedin_experience
  project_summary
}

enum TargetAngle {
  general
  ai_ml
  data_engineering
  backend
  full_stack
}

enum ArtifactTone {
  concise
  technical
  recruiter_friendly
}

enum TagDimension {
  domain
  competency
  emphasis
  audience_fit
}

enum GenerationKind {
  claim_research
  claim_cluster_research
  claim_merge
  claim_verification
  highlight_generation
  highlight_verification
  artifact_retrieval
  artifact_generation
  evidence_clustering
  execution_routing
  semantic_extraction
  semantic_repair
  capability_synthesis
  coverage_audit
  answer_completeness_audit
  project_chat_planning
  project_chat_answer
  project_chat_verification
}

enum GenerationStatus {
  queued
  running
  success
  provider_error
  parse_error
  validation_error
}

enum HighlightSuggestionStatus {
  pending
  accepted
  dismissed
}

enum ChatMessageRole {
  user
  assistant
}

enum ChatMessageStatus {
  queued
  running
  awaiting_review
  completed
  failed
  cancelled
}

enum ChatCitationKind {
  highlight
  project_fact
  evidence
  artifact
  github_file
}

enum AgentRunKind {
  chat_turn
  project_research
  artifact_workflow
  manual_evidence_highlights
  repository_refresh
  semantic_worker
  coverage_audit
}

enum AgentRunStatus {
  queued
  running
  awaiting_review
  completed
  insufficient_context
  failed
  cancelled
}

enum AgentRunEventType {
  progress
  tool_call
  tool_result
  status_change
  warning
  error
}

enum AgentRunCandidateKind {
  new_highlight
  highlight_revision
  new_project_fact
  project_fact_revision
}

enum AgentRunCandidateStatus {
  pending
  approved
  edited_and_approved
  denied
}

enum KnowledgeLifecycleStatus {
  active
  needs_validation
  stale
  superseded
  retired
  quarantined
}

enum KnowledgeReviewState {
  pending_review
  reviewed
  reverted
}

enum KnowledgeApprovalSource {
  automation
  user
  legacy
}

enum PublicSafetyStatus {
  not_eligible
  pending
  verified
  failed
}

enum KnowledgeRefreshStatus {
  queued
  inventorying
  analyzing
  routing
  semantic_analysis
  auditing
  reconciling
  completed
  failed
  cancelled
}

enum KnowledgeRefreshQuality {
  pending
  verified
  degraded
  failed
}

enum RepositorySemanticStatus {
  not_selected
  pending
  succeeded
  degraded
  failed
}

enum CapabilityCoverageStatus {
  not_applicable
  static_only
  semantic_verified
  partial
  failed
}

enum KnowledgeRefreshTrigger {
  repository_attach
  webhook_push
  scheduled
  manual
  chat_freshness
  backfill
}

enum GitHubWebhookDeliveryStatus {
  received
  processing
  queued
  failed
  ignored
}

enum RepositoryFileDisposition {
  eligible
  analyzed
  excluded
  unreadable
}

enum RepositoryFileChangeType {
  unchanged
  added
  modified
  renamed
}

enum KnowledgeChangeEntityKind {
  evidence
  highlight
  project_fact
  artifact
}

enum KnowledgeChangeAction {
  created
  updated
  revalidated
  retired
  quarantined
}

enum KnowledgeChangeDecision {
  pending
  kept
  edited_and_kept
  reverted
  retired
}

enum EmbeddingIndexStatus {
  building
  ready
  active
  failed
  retired
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  careerStage      CareerStage?
  currentGoal      String?
  focusPreference  FocusPreference?
  workItems        WorkItem[]
  artifacts        Artifact[]
  chatThreads      ChatThread[]
  agentRuns        AgentRun[]
  githubConnection GitHubConnection?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model WorkItem {
  id                      String                       @id @default(cuid())
  userId                  String
  title                   String
  type                    WorkItemType
  description             String
  startDate               DateTime?
  endDate                 DateTime?
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources                 Source[]
  evidenceItems           EvidenceItem[]
  highlights              Highlight[]
  projectFacts            ProjectFact[]
  highlightSuggestions    HighlightSuggestion[]
  artifacts               Artifact[]
  generationRuns          GenerationRun[]
  chatThreads             ChatThread[]
  agentRuns               AgentRun[]
  knowledgeRefreshRuns    KnowledgeRefreshRun[]
  githubWebhookDeliveries GitHubWebhookDelivery[]
  repositorySnapshots     RepositorySnapshot[]
  knowledgeChanges        KnowledgeChange[]
  capabilityLedger        RepositoryCapabilityLedger[]
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
}

model Source {
  id                      String                  @id @default(cuid())
  workItemId              String
  type                    SourceType
  label                   String
  externalId              String?
  rawContent              String?
  metadata                Json?
  workItem                WorkItem                @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  evidenceItems           EvidenceItem[]
  chatCitations           ChatCitation[]
  repositorySnapshots     RepositorySnapshot[]
  githubWebhookDeliveries GitHubWebhookDelivery[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([workItemId, type, externalId])
}

model KnowledgeRefreshRun {
  id                      String                       @id @default(cuid())
  workItemId              String
  workflowId              String?                      @unique
  idempotencyKey          String
  trigger                 KnowledgeRefreshTrigger
  status                  KnowledgeRefreshStatus       @default(queued)
  qualityStatus           KnowledgeRefreshQuality      @default(pending)
  targetHeads             Json
  completedHeads          Json?
  coverage                Json?
  progress                Json?
  warnings                Json?
  error                   Json?
  orchestration           Json?
  budgetUsage             Json?
  startedAt               DateTime?
  finishedAt              DateTime?
  workItem                WorkItem                     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  snapshots               RepositorySnapshot[]
  changes                 KnowledgeChange[]
  agentRuns               AgentRun[]
  githubWebhookDeliveries GitHubWebhookDelivery[]
  capabilityLedger        RepositoryCapabilityLedger[]
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@unique([workItemId, idempotencyKey])
  @@index([workItemId, status, updatedAt])
}

model GitHubWebhookDelivery {
  id                  String                      @id @default(cuid())
  deliveryId          String
  sourceId            String
  workItemId          String
  refreshRunId        String?
  event               String
  repositoryId        String
  repositoryFullName  String
  ref                 String?
  afterSha            String?
  status              GitHubWebhookDeliveryStatus @default(received)
  attemptCount        Int                         @default(0)
  error               Json?
  receivedAt          DateTime                    @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  source              Source                      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workItem            WorkItem                    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  refreshRun          KnowledgeRefreshRun?        @relation(fields: [refreshRunId], references: [id], onDelete: SetNull)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([deliveryId, sourceId])
  @@index([workItemId, status, createdAt])
  @@index([status, processingStartedAt])
  @@index([status, processedAt])
  @@index([refreshRunId])
  @@index([repositoryId, receivedAt])
}

model RepositorySnapshot {
  id                String                       @id @default(cuid())
  workItemId        String
  sourceId          String
  refreshRunId      String?
  branch            String
  commitSha         String
  treeSha           String
  committedAt       DateTime?
  resolvedAt        DateTime
  inventoryComplete Boolean                      @default(false)
  analysisComplete  Boolean                      @default(false)
  coverageComplete  Boolean                      @default(false)
  manifestHash      String?
  coverage          Json?
  warnings          Json?
  delta             Json?
  workItem          WorkItem                     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  source            Source                       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  refreshRun        KnowledgeRefreshRun?         @relation(fields: [refreshRunId], references: [id], onDelete: SetNull)
  files             RepositoryFileSnapshot[]
  evidenceItems     EvidenceItem[]
  capabilityLedger  RepositoryCapabilityLedger[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([sourceId, commitSha])
  @@index([workItemId, coverageComplete, resolvedAt])
  @@index([refreshRunId])
}

model RepositoryFileSnapshot {
  id                      String                    @id @default(cuid())
  snapshotId              String
  path                    String
  blobSha                 String?
  sizeBytes               Int?
  language                String?
  disposition             RepositoryFileDisposition
  changeType              RepositoryFileChangeType  @default(added)
  exclusionReason         String?
  contentHash             String?
  analyzerVersion         String?
  analysis                Json?
  analyzedAt              DateTime?
  semanticStatus          RepositorySemanticStatus  @default(not_selected)
  semanticAnalyzerVersion String?
  semanticRefreshRunId    String?
  semanticAnalysis        Json?
  semanticDiagnostics     Json?
  semanticAnalyzedAt      DateTime?
  snapshot                RepositorySnapshot        @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([snapshotId, path])
  @@index([snapshotId, disposition, path])
  @@index([blobSha, analyzerVersion])
  @@index([snapshotId, semanticStatus, path])
  @@index([semanticRefreshRunId, semanticStatus])
}

model RepositoryCapabilityLedger {
  id                       String                   @id @default(cuid())
  workItemId               String
  snapshotId               String
  refreshRunId             String?
  capabilityKey            String
  label                    String
  status                   CapabilityCoverageStatus
  priority                 Int                      @default(0)
  representativeFileIds    Json
  staticObservationCount   Int                      @default(0)
  semanticObservationCount Int                      @default(0)
  producedEntityRefs       Json?
  gaps                     Json?
  workerRunIds             Json?
  analyzerVersion          String
  policyVersion            String
  workItem                 WorkItem                 @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  snapshot                 RepositorySnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  refreshRun               KnowledgeRefreshRun?     @relation(fields: [refreshRunId], references: [id], onDelete: SetNull)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([snapshotId, capabilityKey])
  @@index([workItemId, status, priority])
  @@index([refreshRunId])
}

model KnowledgeChange {
  id               String                    @id @default(cuid())
  workItemId       String
  refreshRunId     String?
  entityKind       KnowledgeChangeEntityKind
  action           KnowledgeChangeAction
  decision         KnowledgeChangeDecision   @default(pending)
  evidenceItemId   String?
  highlightId      String?
  projectFactId    String?
  artifactId       String?
  beforeSnapshot   Json?
  afterSnapshot    Json?
  reason           String
  provenance       Json?
  downstreamImpact Json?
  policyVersion    String
  modelId          String?
  idempotencyKey   String
  reviewedAt       DateTime?
  reviewedByUserId String?
  feedback         String?
  workItem         WorkItem                  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  refreshRun       KnowledgeRefreshRun?      @relation(fields: [refreshRunId], references: [id], onDelete: SetNull)
  evidenceItem     EvidenceItem?             @relation(fields: [evidenceItemId], references: [id], onDelete: SetNull)
  highlight        Highlight?                @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  projectFact      ProjectFact?              @relation(fields: [projectFactId], references: [id], onDelete: SetNull)
  artifact         Artifact?                 @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([workItemId, idempotencyKey])
  @@index([workItemId, decision, createdAt])
  @@index([refreshRunId, action])
  @@index([evidenceItemId])
  @@index([highlightId])
  @@index([projectFactId])
  @@index([artifactId])
}

model GitHubConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  githubUserId         String   @unique
  login                String
  accessTokenEncrypted String
  scope                String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model EvidenceItem {
  id                        String                       @id @default(cuid())
  workItemId                String
  sourceId                  String
  externalId                String
  type                      EvidenceItemType
  title                     String
  content                   String
  searchText                String
  parentKind                String?
  parentKey                 String?
  included                  Boolean                      @default(true)
  metadata                  Json?
  logicalKey                String?
  lifecycleStatus           KnowledgeLifecycleStatus     @default(active)
  reviewState               KnowledgeReviewState         @default(reviewed)
  approvalSource            KnowledgeApprovalSource      @default(legacy)
  publicSafetyStatus        PublicSafetyStatus           @default(not_eligible)
  validatedThroughSha       String?
  lastValidatedAt           DateTime?
  autoAppliedAt             DateTime?
  purgeEligibleAt           DateTime?
  supersedesEvidenceItemId  String?
  repositorySnapshotId      String?
  workItem                  WorkItem                     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  source                    Source                       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  repositorySnapshot        RepositorySnapshot?          @relation(fields: [repositorySnapshotId], references: [id], onDelete: SetNull)
  supersedesEvidenceItem    EvidenceItem?                @relation("EvidenceSupersession", fields: [supersedesEvidenceItemId], references: [id], onDelete: SetNull)
  supersededByEvidenceItems EvidenceItem[]               @relation("EvidenceSupersession")
  highlightEvidence         HighlightEvidence[]
  projectFactEvidence       ProjectFactEvidence[]
  tags                      EvidenceTag[]
  embeddings                EvidenceEmbedding[]
  chatCitations             ChatCitation[]
  artifactProvenance        ArtifactEvidenceProvenance[]
  knowledgeChanges          KnowledgeChange[]
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  @@unique([sourceId, externalId])
  @@index([workItemId, included, updatedAt])
  @@index([workItemId, parentKind, parentKey])
  @@index([workItemId, lifecycleStatus, reviewState, updatedAt])
  @@index([sourceId, logicalKey, lifecycleStatus])
  @@index([repositorySnapshotId])
  @@index([supersedesEvidenceItemId])
}

model EvidenceTag {
  id             String       @id @default(cuid())
  evidenceItemId String
  dimension      TagDimension
  tag            String
  score          Float?
  evidenceItem   EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([evidenceItemId, dimension, tag])
  @@index([dimension, tag])
}

model Highlight {
  id                     String                        @id @default(cuid())
  workItemId             String
  text                   String
  summary                String
  searchText             String
  confidence             ClaimConfidence
  ownershipClarity       OwnershipClarity
  sensitivityFlag        Boolean                       @default(false)
  verificationStatus     VerificationStatus
  visibility             VisibilityLevel
  risksSummary           String?
  missingInfo            String?
  rejectionReason        String?
  verificationNotes      String?
  metadata               Json?
  lifecycleStatus        KnowledgeLifecycleStatus      @default(active)
  reviewState            KnowledgeReviewState          @default(reviewed)
  approvalSource         KnowledgeApprovalSource       @default(legacy)
  publicSafetyStatus     PublicSafetyStatus            @default(not_eligible)
  validatedThroughSha    String?
  validationHeads        Json?
  lastValidatedAt        DateTime?
  autoAppliedAt          DateTime?
  supersedesHighlightId  String?
  workItem               WorkItem                      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  supersedesHighlight    Highlight?                    @relation("HighlightSupersession", fields: [supersedesHighlightId], references: [id], onDelete: SetNull)
  supersededByHighlights Highlight[]                   @relation("HighlightSupersession")
  evidence               HighlightEvidence[]
  tags                   HighlightTag[]
  embeddings             HighlightEmbedding[]
  suggestions            HighlightSuggestion[]
  chatCitations          ChatCitation[]
  artifactProvenance     ArtifactHighlightProvenance[]
  agentRunCandidates     AgentRunCandidate[]
  knowledgeChanges       KnowledgeChange[]
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([workItemId, lifecycleStatus, reviewState, updatedAt])
  @@index([supersedesHighlightId])
  @@map("Claim")
}

model HighlightEmbedding {
  id             String                     @id @default(cuid())
  highlightId    String
  indexVersionId String
  modelId        String
  dimensions     Int
  inputHash      String
  inputText      String
  embedding      Unsupported("vector(512)")
  inputTokens    Int?
  costUsd        Decimal?                   @db.Decimal(18, 10)
  highlight      Highlight                  @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  indexVersion   EmbeddingIndexVersion      @relation(fields: [indexVersionId], references: [id], onDelete: Restrict)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([highlightId, indexVersionId])
  @@index([indexVersionId])
}

model ProjectFact {
  id                       String                   @id @default(cuid())
  workItemId               String
  statement                String
  category                 ProjectFactCategory
  confidence               ClaimConfidence
  status                   ProjectFactStatus        @default(draft)
  sensitivityFlag          Boolean                  @default(false)
  reviewNotes              String?
  metadata                 Json?
  rejectionReason          String?
  searchText               String
  supersedesProjectFactId  String?
  lifecycleStatus          KnowledgeLifecycleStatus @default(active)
  reviewState              KnowledgeReviewState     @default(reviewed)
  approvalSource           KnowledgeApprovalSource  @default(legacy)
  publicSafetyStatus       PublicSafetyStatus       @default(not_eligible)
  validatedThroughSha      String?
  validationHeads          Json?
  lastValidatedAt          DateTime?
  autoAppliedAt            DateTime?
  subsystemKey             String?
  productImportance        Int?
  implementationBreadth    Int?
  technicalDifficulty      Int?
  distinctiveness          Int?
  workItem                 WorkItem                 @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  evidence                 ProjectFactEvidence[]
  embeddings               ProjectFactEmbedding[]
  chatCitations            ChatCitation[]
  agentRunCandidates       AgentRunCandidate[]
  supersedesProjectFact    ProjectFact?             @relation("ProjectFactSupersession", fields: [supersedesProjectFactId], references: [id], onDelete: SetNull)
  supersededByProjectFacts ProjectFact[]            @relation("ProjectFactSupersession")
  knowledgeChanges         KnowledgeChange[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([workItemId, status, updatedAt])
  @@index([supersedesProjectFactId])
  @@index([workItemId, lifecycleStatus, reviewState, updatedAt])
  @@index([workItemId, subsystemKey, lifecycleStatus])
}

model ProjectFactEvidence {
  id             String       @id @default(cuid())
  projectFactId  String
  evidenceItemId String
  relevanceScore Float?
  projectFact    ProjectFact  @relation(fields: [projectFactId], references: [id], onDelete: Cascade)
  evidenceItem   EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([projectFactId, evidenceItemId])
  @@index([evidenceItemId])
}

model ProjectFactEmbedding {
  id             String                     @id @default(cuid())
  projectFactId  String
  indexVersionId String
  modelId        String
  dimensions     Int
  inputHash      String
  inputText      String
  embedding      Unsupported("vector(512)")
  inputTokens    Int?
  costUsd        Decimal?                   @db.Decimal(18, 10)
  projectFact    ProjectFact                @relation(fields: [projectFactId], references: [id], onDelete: Cascade)
  indexVersion   EmbeddingIndexVersion      @relation(fields: [indexVersionId], references: [id], onDelete: Restrict)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([projectFactId, indexVersionId])
  @@index([indexVersionId])
}

model EvidenceEmbedding {
  id             String                     @id @default(cuid())
  evidenceItemId String
  indexVersionId String
  modelId        String
  dimensions     Int
  inputHash      String
  inputText      String
  embedding      Unsupported("vector(512)")
  inputTokens    Int?
  costUsd        Decimal?                   @db.Decimal(18, 10)
  evidenceItem   EvidenceItem               @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  indexVersion   EmbeddingIndexVersion      @relation(fields: [indexVersionId], references: [id], onDelete: Restrict)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([evidenceItemId, indexVersionId])
  @@index([indexVersionId])
}

model HighlightSuggestion {
  id                 String                    @id @default(cuid())
  workItemId         String
  sourceHighlightId  String
  status             HighlightSuggestionStatus @default(pending)
  suggestionType     String
  currentSnapshot    Json
  suggestedDraft     Json
  matchReason        String
  cosineDistance     Float?
  sourceEvidenceIds  Json
  generationRunIds   Json?
  workItem           WorkItem                  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  sourceHighlight    Highlight                 @relation(fields: [sourceHighlightId], references: [id], onDelete: Cascade)
  agentRunCandidates AgentRunCandidate[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([workItemId, status, createdAt])
  @@index([sourceHighlightId, status])
}

model HighlightEvidence {
  id             String       @id @default(cuid())
  highlightId    String
  evidenceItemId String
  relevanceScore Float?
  highlight      Highlight    @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  evidenceItem   EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([highlightId, evidenceItemId])
}

model HighlightTag {
  id          String       @id @default(cuid())
  highlightId String
  dimension   TagDimension
  tag         String
  score       Float?
  highlight   Highlight    @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([highlightId, dimension, tag])
  @@index([dimension, tag])
}

model Artifact {
  id                    String                        @id @default(cuid())
  userId                String
  workItemId            String?
  originatingAgentRunId String?                       @unique
  type                  ArtifactType
  targetAngle           TargetAngle
  tone                  ArtifactTone
  requestBrief          String
  content               String
  searchText            String
  lifecycleStatus       KnowledgeLifecycleStatus      @default(active)
  reviewState           KnowledgeReviewState          @default(reviewed)
  approvalSource        KnowledgeApprovalSource       @default(legacy)
  publicSafetyStatus    PublicSafetyStatus            @default(not_eligible)
  validatedThroughSha   String?
  lastValidatedAt       DateTime?
  autoAppliedAt         DateTime?
  staleReason           String?
  supersedesArtifactId  String?
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem              WorkItem?                     @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  originatingAgentRun   AgentRun?                     @relation(fields: [originatingAgentRunId], references: [id], onDelete: SetNull)
  supersedesArtifact    Artifact?                     @relation("ArtifactSupersession", fields: [supersedesArtifactId], references: [id], onDelete: SetNull)
  supersededByArtifacts Artifact[]                    @relation("ArtifactSupersession")
  embeddings            ArtifactEmbedding[]
  chatCitations         ChatCitation[]
  highlightProvenance   ArtifactHighlightProvenance[]
  evidenceProvenance    ArtifactEvidenceProvenance[]
  knowledgeChanges      KnowledgeChange[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([workItemId, updatedAt])
  @@index([workItemId, lifecycleStatus, reviewState, updatedAt])
  @@index([supersedesArtifactId])
}

model ArtifactEmbedding {
  id             String                     @id @default(cuid())
  artifactId     String
  indexVersionId String
  modelId        String
  dimensions     Int
  inputHash      String
  inputText      String
  embedding      Unsupported("vector(512)")
  inputTokens    Int?
  costUsd        Decimal?                   @db.Decimal(18, 10)
  artifact       Artifact                   @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  indexVersion   EmbeddingIndexVersion      @relation(fields: [indexVersionId], references: [id], onDelete: Restrict)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([artifactId, indexVersionId])
  @@index([indexVersionId])
}

model EmbeddingIndexVersion {
  id                    String                  @id @default(cuid())
  key                   String                  @unique
  provider              String
  modelId               String
  dimensions            Int
  status                EmbeddingIndexStatus    @default(building)
  writeEnabled          Boolean                 @default(true)
  baseActivationEpoch   Int
  buildStartedAt        DateTime                @default(now())
  buildCompletedAt      DateTime?
  reconciledAt          DateTime?
  activatedAt           DateTime?
  validation            Json?
  qualityGatePassed     Boolean                 @default(false)
  qualityValidatedAt    DateTime?
  qualityReport         Json?
  lastError             Json?
  highlightEmbeddings   HighlightEmbedding[]
  projectFactEmbeddings ProjectFactEmbedding[]
  evidenceEmbeddings    EvidenceEmbedding[]
  artifactEmbeddings    ArtifactEmbedding[]
  activeControls        EmbeddingIndexControl[] @relation("ActiveEmbeddingIndexVersion")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([status, writeEnabled])
}

model EmbeddingIndexControl {
  id              String                @id
  activeVersionId String                @unique
  activationEpoch Int                   @default(0)
  writeSetEpoch   Int                   @default(0)
  activeVersion   EmbeddingIndexVersion @relation("ActiveEmbeddingIndexVersion", fields: [activeVersionId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ArtifactHighlightProvenance {
  id                String     @id @default(cuid())
  artifactId        String
  highlightId       String?
  highlightSnapshot Json
  rank              Int?
  relevanceScore    Float?
  artifact          Artifact   @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  highlight         Highlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())

  @@unique([artifactId, highlightId])
  @@index([highlightId])
}

model ArtifactEvidenceProvenance {
  id               String        @id @default(cuid())
  artifactId       String
  evidenceItemId   String?
  evidenceSnapshot Json
  rank             Int?
  relevanceScore   Float?
  artifact         Artifact      @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  evidenceItem     EvidenceItem? @relation(fields: [evidenceItemId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())

  @@unique([artifactId, evidenceItemId])
  @@index([evidenceItemId])
}

model ChatThread {
  id                String        @id @default(cuid())
  userId            String
  workItemId        String
  title             String
  rollingSummary    String?
  conversationState Json?
  archivedAt        DateTime?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem          WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  messages          ChatMessage[]
  agentRuns         AgentRun[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, workItemId, archivedAt, updatedAt])
}

model ChatMessage {
  id          String            @id @default(cuid())
  threadId    String
  agentRunId  String?
  sequence    Int
  role        ChatMessageRole
  status      ChatMessageStatus @default(completed)
  content     String
  metadata    Json?
  finalizedAt DateTime?
  thread      ChatThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agentRun    AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  citations   ChatCitation[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([threadId, sequence])
  @@index([agentRunId])
  @@index([threadId, createdAt])
}

model ChatCitation {
  id             String           @id @default(cuid())
  messageId      String
  kind           ChatCitationKind
  ordinal        Int
  highlightId    String?
  projectFactId  String?
  evidenceItemId String?
  artifactId     String?
  sourceId       String?
  label          String
  excerpt        String?
  immutableUrl   String?
  repository     String?
  commitSha      String?
  blobSha        String?
  path           String?
  startLine      Int?
  endLine        Int?
  contentHash    String?
  metadata       Json?
  message        ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  highlight      Highlight?       @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  projectFact    ProjectFact?     @relation(fields: [projectFactId], references: [id], onDelete: SetNull)
  evidenceItem   EvidenceItem?    @relation(fields: [evidenceItemId], references: [id], onDelete: SetNull)
  artifact       Artifact?        @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  source         Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@unique([messageId, ordinal])
  @@index([highlightId])
  @@index([projectFactId])
  @@index([evidenceItemId])
  @@index([artifactId])
  @@index([sourceId])
  @@index([repository, commitSha, path])
}

model AgentRun {
  id                    String               @id @default(cuid())
  userId                String
  workItemId            String
  threadId              String?
  parentRunId           String?
  knowledgeRefreshRunId String?
  workflowId            String?              @unique
  idempotencyKey        String
  kind                  AgentRunKind
  status                AgentRunStatus       @default(queued)
  request               Json
  attemptNumber         Int                  @default(0)
  workflowRecoveryCount Int                  @default(0)
  result                Json?
  error                 Json?
  harnessVersion        String               @default("v4")
  environmentSnapshot   Json?
  researchState         Json?
  provisionalResult     Json?
  startedAt             DateTime?
  finishedAt            DateTime?
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem              WorkItem             @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  thread                ChatThread?          @relation(fields: [threadId], references: [id], onDelete: SetNull)
  parentRun             AgentRun?            @relation("AgentRunHierarchy", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns             AgentRun[]           @relation("AgentRunHierarchy")
  knowledgeRefreshRun   KnowledgeRefreshRun? @relation(fields: [knowledgeRefreshRunId], references: [id], onDelete: SetNull)
  messages              ChatMessage[]
  events                AgentRunEvent[]
  candidates            AgentRunCandidate[]
  artifact              Artifact?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([workItemId, status, updatedAt])
  @@index([threadId, createdAt])
  @@index([parentRunId])
  @@index([knowledgeRefreshRunId])
}

model AgentRunEvent {
  id            String            @id @default(cuid())
  agentRunId    String
  sequence      Int
  type          AgentRunEventType
  message       String?
  toolName      String?
  payload       Json?
  isUserVisible Boolean           @default(true)
  agentRun      AgentRun          @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@unique([agentRunId, sequence])
  @@index([agentRunId, createdAt])
}

model AgentRunCandidate {
  id                    String                  @id @default(cuid())
  agentRunId            String
  highlightId           String?
  projectFactId         String?
  highlightSuggestionId String?
  kind                  AgentRunCandidateKind
  status                AgentRunCandidateStatus @default(pending)
  batchNumber           Int                     @default(1)
  ordinal               Int
  snapshot              Json
  editedText            String?
  feedback              String?
  reviewedAt            DateTime?
  agentRun              AgentRun                @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  highlight             Highlight?              @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  projectFact           ProjectFact?            @relation(fields: [projectFactId], references: [id], onDelete: SetNull)
  highlightSuggestion   HighlightSuggestion?    @relation(fields: [highlightSuggestionId], references: [id], onDelete: SetNull)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([agentRunId, batchNumber, ordinal])
  @@index([agentRunId, status, batchNumber])
  @@index([highlightId])
  @@index([projectFactId])
  @@index([highlightSuggestionId])
}

model GenerationRun {
  id               String           @id @default(cuid())
  workItemId       String
  kind             GenerationKind
  status           GenerationStatus @default(queued)
  idempotencyKey   String?
  provider         String
  modelId          String
  inputSummary     Json
  rawOutput        String?
  parsedOutput     Json?
  validationErrors Json?
  resultRefs       Json?
  tokenUsage       Json?
  estimatedCostUsd Float?
  workItem         WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([workItemId, idempotencyKey])
  @@index([workItemId, kind, createdAt])
}
